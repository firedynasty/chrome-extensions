{
  "manifest_version": 3,
  "name": "Gradient Line",
  "version": "1.0",
  "description": "A moving spectrum line across the top of any page. Toggle on/off via the toolbar icon.",
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Toggle gradient line"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
