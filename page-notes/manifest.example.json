{
  "manifest_version": 3,
  "name": "Page Notes",
  "version": "2.0",
  "description": "A floating notes panel on any page, backed by a Google Doc you pick from a Recent list — not per-page localStorage.",
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_CHROME_EXTENSION_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Toggle Page Notes"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
