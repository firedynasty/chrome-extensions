{
  "manifest_version": 3,
  "name": "Page Scroll Buttons",
  "version": "1.1",
  "description": "Overlays page up / page down buttons on any page (handy on X/Twitter). Toggle via the toolbar icon.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Toggle Page Up/Down buttons"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
