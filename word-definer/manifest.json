{
  "manifest_version": 3,
  "name": "Word Definer",
  "version": "1.1",
  "description": "Select any word on a page to see its definition in a tooltip. Toggle on/off via the toolbar icon.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://api.dictionaryapi.dev/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
